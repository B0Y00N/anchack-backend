DB_ROOT_PASSWORD=localpassword

# JWT 서명 키 — 최소 32바이트(256bit) 랜덤 문자열, 로그인 기능에 필수
# 생성: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# 카카오 로그인을 테스트할 경우에만 필요 (없으면 빈 값으로 기동되고 카카오 로그인만 실패함)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 국토부 전월세 실거래가 수집 설정
# 서비스 키는 공공데이터포털의 Decoding 인증키를 사용
MOLIT_API_SERVICE_KEY=
MOLIT_API_NUM_OF_ROWS=
MOLIT_API_CONNECT_TIMEOUT_MS=
MOLIT_API_READ_TIMEOUT_MS=

# 카카오 장소 수집(주변 장소 검색) - 카카오 개발자 콘솔의 REST API 키 사용
KAKAO_PLACE_REST_API_KEY=
KAKAO_PLACE_RADIUS=
KAKAO_PLACE_PAGE_SIZE=
KAKAO_PLACE_MAX_PAGE=
KAKAO_PLACE_CONNECT_TIMEOUT_MS=
KAKAO_PLACE_READ_TIMEOUT_MS=

# 카카오 대중교통 길찾기(주소 검색 + publictraffic) - place 도메인과 같은 카카오 앱의
# REST API 키를 재사용 가능(같은 값을 KAKAO_PLACE_REST_API_KEY에도 넣으면 됨)
KAKAO_ROUTE_REST_API_KEY=
KAKAO_ROUTE_CONNECT_TIMEOUT_MS=
KAKAO_ROUTE_READ_TIMEOUT_MS=

# recommendation_reason/caution 생성 - stub(기본값, 토큰 비용 없음) 또는 openai
# openai로 바꾸면 아래 OPENAI_PROXY_* 설정으로 실제 프록시를 호출함
RECOMMENDATION_REASON_MODE=stub

# 팀 LLM 프록시 서버(OpenAI Chat Completions 호환 포맷)
OPENAI_PROXY_BASE_URL=
OPENAI_PROXY_TOKEN=
OPENAI_PROXY_MODEL=gpt-4o-mini
OPENAI_PROXY_MAX_TOKENS=
OPENAI_PROXY_CONNECT_TIMEOUT_MS=
OPENAI_PROXY_READ_TIMEOUT_MS=
