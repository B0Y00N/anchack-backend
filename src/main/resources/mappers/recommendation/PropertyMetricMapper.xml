<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbait.anchack.recommendation.mapper.PropertyMetricMapper">

  <!-- property_metrics 단일 스냅샷에서 요청 조건에 맞는 행을 직접 조회한다. -->
  <select
    id="findLatestByDongsRentalTypeAndHouseTypes"
    resultType="com.kbait.anchack.recommendation.dto.PropertyMetricCandidateRow"
  >
    SELECT
      pm.admin_dong_id,
      pm.house_type,
      pm.avg_deposit,
      pm.avg_rent,
      pm.avg_area
    FROM property_metrics pm
    WHERE pm.admin_dong_id IN
    <foreach collection="adminDongIds" item="adminDongId" open="(" separator="," close=")">
      #{adminDongId}
    </foreach>
    AND pm.rental_type = #{rentalType}
    AND pm.house_type IN
    <foreach collection="houseTypes" item="houseType" open="(" separator="," close=")">
      #{houseType}
    </foreach>
  </select>

</mapper>
