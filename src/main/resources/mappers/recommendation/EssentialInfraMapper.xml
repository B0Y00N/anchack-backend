<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbait.anchack.recommendation.mapper.EssentialInfraMapper">

  <select
    id="findCategoriesByDongsAndCategories"
    resultType="com.kbait.anchack.recommendation.dto.AdminDongCategoryRow"
  >
    SELECT DISTINCT admin_dong_id, category
    FROM places
    WHERE admin_dong_id IN
    <foreach collection="adminDongIds" item="adminDongId" open="(" separator="," close=")">
      #{adminDongId}
    </foreach>
    AND category IN
    <foreach collection="categories" item="category" open="(" separator="," close=")">
      #{category}
    </foreach>
  </select>

</mapper>
