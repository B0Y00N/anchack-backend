<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbait.anchack.condition.mapper.PreferredHouseTypeMapper">

  <insert id="insertBatch">
    INSERT INTO preferred_house_types (condition_id, house_type)
    VALUES
    <foreach collection="rows" item="row" separator=",">
      (#{row.conditionId}, #{row.houseType})
    </foreach>
  </insert>

  <select id="findHouseTypesByConditionId" resultType="java.lang.String">
    SELECT house_type
    FROM preferred_house_types
    WHERE condition_id = #{conditionId}
  </select>

  <delete id="deleteByConditionId">
    DELETE FROM preferred_house_types
    WHERE condition_id = #{conditionId}
  </delete>

</mapper>
