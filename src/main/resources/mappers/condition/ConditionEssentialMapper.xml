<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kbait.anchack.condition.mapper.ConditionEssentialMapper">

  <insert id="insertBatch">
    INSERT INTO condition_essentials (condition_id, category)
    VALUES
    <foreach collection="rows" item="row" separator=",">
      (#{row.conditionId}, #{row.category})
    </foreach>
  </insert>

  <select id="findCategoriesByConditionId" resultType="java.lang.String">
    SELECT category
    FROM condition_essentials
    WHERE condition_id = #{conditionId}
  </select>

  <delete id="deleteByConditionId">
    DELETE FROM condition_essentials
    WHERE condition_id = #{conditionId}
  </delete>

</mapper>
